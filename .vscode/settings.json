        "Use of this source code is governed by terms that can be",
        "found in the LICENSE file in the root of this package."
      ]
    },
    {
      "language": "markdown",
      "template": [
        "@license",
        "Copyright (c) Audanika. All Rights Reserved.",
        "",
        "Use of this source code is governed by terms that can be",
        "found in the LICENSE file in the root of this package."
      ]
    },
    {
      "language": "md",
      "template": [
        "@license",
        "Copyright (c) Audanika. All Rights Reserved.",
        "",
        "Use of this source code is governed by terms that can be",
        "found in the LICENSE file in the root of this package."
      ]
    }
  ],
  "psi-header.lang-config": [
    {
      "language": "json",
      "begin": "",
      "prefix": "",
      "suffix": "",
      "end": "",
      "lineLength": 80,
      "beforeHeader": [],
      "afterHeader": []
    },
    {
      "language": "xml",
      "begin": "<!--",
      "prefix": "  ",
      "suffix": "",
      "lineLength": 80,
      "end": " -->",
      "forceToTop": true,
      "blankLinesAfter": 1,
      "beforeHeader": [],
      "afterHeader": []
    },
    {
      "language": "html",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "language": "typescript",
      "prefix": "// ",
      "begin": "",
      "end": ""
    },
    {
      "language": "scss",
      "prefix": "// ",
      "begin": "",
      "end": ""
    },
    {
      "language": "markdown",
      "prefix": "",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "language": "md",
      "prefix": "",
      "begin": "<!--",
      "end": "-->"
    },
    {
      "language": "dart",
      "prefix": "// ",
      "begin": "",
      "end": ""
    }
  ],
  "psi-header.changes-tracking": {
    "isActive": false,
    "autoHeader": "autoSave",
    "enforceHeader": false
  },
  "psi-header.config": {
    "forceToTop": true
  },
  "dartImport.fixOnSave": true,
  "dartImport.showErrorMessages": false,
  "[dot]": {
    "editor.defaultFormatter": "tintinweb.graphviz-interactive-preview"
  }
}
